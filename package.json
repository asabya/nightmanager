{
  "name": "nightmanager",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Finder, Oracle, Manager, and Worker tools for Pi's Nightmanager workflow",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "nightmanager"
  ],
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "nightmanager": "dist/bin/nightmanager.js"
  },
  "files": [
    "src",
    "README.md",
    "skills",
    "prompts",
    "integrations",
    "dist"
  ],
  "scripts": {
    "build": "npm run check:generated && npm run typecheck && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "tsx scripts/generate-prompts.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/shared/generated-prompts.ts integrations/claude-code/agents",
    "install:claude:test": "tsx bin/nightmanager.ts install claude --dry-run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pi-web-access": "^0.13.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
